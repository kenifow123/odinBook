// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
    id            Int             @id @default(autoincrement())
    email         String          @unique
    username      String          @unique
    password      String

    posts Post[]

    profile       Profile? @relation("userProfile")

    followers User[] @relation("UserFollowers")
    followedBy User[] @relation("UserFollowers")

    likedPosts  Post[] @relation("PostLikes")
    likedComments    Comment[] @relation("CommentLikes")

    comments    Comment[]

    sentFollowRequests     FollowRequest[] @relation("FollowRequester")
    receivedFollowRequests FollowRequest[] @relation("FollowRequested")
}

model Post {
  id        Int     @id @default(autoincrement())
  content   String?
  imageUrl  String?
  createdAt DateTime    @default(now())

  author    User    @relation(fields: [authorId], references: [id])
  authorId  Int

  comments  Comment[]
  usersLiked  User[]  @relation("PostLikes")
}

model Comment {
    id  Int @id @default(autoincrement())
    content String
    createdAt   DateTime    @default(now())

    author  User    @relation(fields: [authorId], references: [id])
    authorId    Int

    postId  Int
    post    Post    @relation(fields: [postId], references: [id])

    usersLiked  User[]  @relation("CommentLikes")
}

model Profile {
    id        Int     @id @default(autoincrement())
    imageUrl    String?

    userId  Int @unique
    user    User    @relation("userProfile", fields: [userId], references: [id])

}

model FollowRequest {
    id  Int @id @default(autoincrement())

    requesterId Int
    requester   User    @relation("FollowRequester", fields: [requesterId], references: [id])

    requestedId Int
    requested   User    @relation("FollowRequested", fields: [requestedId], references: [id])

    @@unique([requesterId, requestedId])
}